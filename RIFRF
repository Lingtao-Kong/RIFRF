# RIFRF: Robust Interval-Valued Fuzzy Regression Functions
# Single simulation example
# DGP for interval‑valued fuzzy data

library(robustbase)

#' Multivariate interval‑valued distance function
#' @param point_a vector of interval bounds: [lower1,upper1,lower2,upper2,...]
#' @param point_b vector of interval bounds
#' @return Euclidean‑type distance for interval data
interval_distance_multi <- function(point_a, point_b) {
  n_features <- length(point_a) / 2
  total_distance <- 0
  
  for(j in 1:n_features) {
    idx_lower <- 2*(j-1) + 1
    idx_upper <- 2*(j-1) + 2
    
    center_a <- (point_a[idx_lower] + point_a[idx_upper]) / 2
    radius_a <- (point_a[idx_upper] - point_a[idx_lower]) / 2
    
    center_b <- (point_b[idx_lower] + point_b[idx_upper]) / 2
    radius_b <- (point_b[idx_upper] - point_b[idx_lower]) / 2
    
    feature_distance <- (center_a - center_b)^2 + (radius_a - radius_b)^2
    total_distance <- total_distance + feature_distance
  }
  return(sqrt(total_distance))
}

#' FKM‑noise clustering for multivariate interval‑valued data
#' @param data n by 2d matrix, each feature stored as (lower, upper)
#' @param k number of clusters
#' @param delta noise‑cluster parameter
#' @param m fuzzifier
#' @param max_iter maximum iterations
#' @param tol convergence tolerance
#' @return list(U,H,D,J,clusters,iterations)
fkm_noise <- function(data, k, delta, m = 2, max_iter = 100, tol = 1e-5) {
  n <- nrow(data)
  n_features <- ncol(data) / 2
  
  U <- matrix(runif(n * k), nrow = n, ncol = k)
  U <- U / rowSums(U)
  
  H <- matrix(0, nrow = k, ncol = ncol(data))
  
  for(iter in 1:max_iter) {
    U_old <- U
    
    for(j in 1:k) {
      for(feature in 1:n_features) {
        idx_lower <- 2*(feature-1) + 1
        idx_upper <- 2*(feature-1) + 2
        
        numerator_lower <- sum(U[,j]^m * data[,idx_lower])
        numerator_upper <- sum(U[,j]^m * data[,idx_upper])
        denominator <- sum(U[,j]^m)
        
        H[j, idx_lower] <- numerator_lower / denominator
        H[j, idx_upper] <- numerator_upper / denominator
      }
    }
    
    D <- matrix(0, nrow = n, ncol = k)
    for(i in 1:n) {
      for(j in 1:k) {
        D[i,j] <- interval_distance_multi(data[i,], H[j,])
      }
    }
    
    for(i in 1:n) {
      for(j in 1:k) {
        sum_term <- 0
        for(h in 1:k) {
          if(D[i,h] > 0) {
            sum_term <- sum_term + (D[i,j] / D[i,h])^(2/(m-1))
          }
        }
        if(D[i,j] > 0) {
          U[i,j] <- 1 / (sum_term + (D[i,j] / delta)^(2/(m-1)))
        } else {
          U[i,j] <- 1
        }
      }
    }
    
    if(max(abs(U - U_old)) < tol) {
      break
    }
  }
  
  J <- 0
  for(i in 1:n) {
    cluster_contrib <- 0
    for(j in 1:k) {
      cluster_contrib <- cluster_contrib + U[i,j]^m * D[i,j]^2
    }
    noise_contrib <- delta^2 * (1 - sum(U[i,]))^m
    J <- J + cluster_contrib + noise_contrib
  }
  
  clusters <- apply(U, 1, which.max)
  
  return(list(
    U = U,
    H = H,
    D = D,
    J = J,
    clusters = clusters,
    iterations = iter
  ))
}

#' Overlap index for two univariate intervals
overlap <- function(interval1, interval2) {
  a <- interval1[1]
  b <- interval1[2]
  c <- interval2[1]
  d <- interval2[2]
  
  intersection_start <- max(a, c)
  intersection_end <- min(b, d)
  
  if (intersection_start > intersection_end) {
    return(0)
  }
  intersection_length <- intersection_end - intersection_start
  union_start <- min(a, c)
  union_end <- max(b, d)
  union_length <- union_end - union_start
  return(intersection_length / union_length)
}

#' Mean overlap over sample
mean_overlap <- function(yl, yu, hat_yl, hat_yu) {
  if (length(yl) != length(yu) || length(yl) != length(hat_yl) || length(yl) != length(hat_yu)) {
    stop("All input vectors must have the same length.")
  }
  n <- length(yl)
  overlaps <- numeric(n)
  for (i in 1:n) {
    true_interval <- c(yl[i], yu[i])
    pred_interval <- c(hat_yl[i], hat_yu[i])
    overlaps[i] <- overlap(true_interval, pred_interval)
  }
  return(mean(overlaps))
}

#----------------------------------------------------------------------
# Data generating process
#----------------------------------------------------------------------
N <- 1000
n <- 400
Xc <- runif(N, -1, 1)
ec <- rnorm(N, 0, 1)
Xr <- runif(N, 1, 3)
er <- rnorm(N, 0, 1)

Yc <- -1 + 2*Xc + Xr + ec
Yr <- 1 + Xc + Xr + er

Xl <- Xc - Xr/2
Xu <- Xc + Xr/2
Yl <- Yc - Yr/2
Yu <- Yc + Yr/2

id <- Yr > 0
data <- data.frame(Xc, Yc, Xr, Yr, Xu, Yu, Xl, Yl)
data <- data[id, ]
data <- data.frame(data[1:n, ])
rownames(data) <- 1:nrow(data)
data <- data.frame(data[, c("Xl", "Yl", "Xu", "Yu", "Xc", "Yc", "Xr", "Yr")])

train_size <- floor(n*0.8)
train <- 1:train_size
p <- 0.2

data$Yc[1:(p*train_size)] <- max(data$Yc) + runif(p*train_size, 2*sd(data$Yc), 3*sd(data$Yc))
data$Yr[1:(p*train_size)] <- max(data$Yr) + runif(p*train_size, 2*sd(data$Yr), 3*sd(data$Yr))

data$Xl <- data$Xc - data$Xr/2
data$Xu <- data$Xc + data$Xr/2
data$Yl <- data$Yc - data$Yr/2
data$Yu <- data$Yc + data$Yr/2

data_lu <- data.frame(data[, c("Xl", "Xu", "Yl", "Yu")])
k <- 3
fkm_res <- fkm_noise(data_lu, k = 3, m = 2, delta = 2)
mem <- fkm_res$U

x11 <- mem[,1]
x12 <- x11^2
x13 <- exp(x11)
data11 <- data.frame(x11, x12, x13, data)

x21 <- mem[,2]
x22 <- x21^2
x23 <- exp(x21)
data12 <- data.frame(x21, x22, x23, data)

x31 <- mem[,3]
x32 <- x31^2
x33 <- exp(x31)
data13 <- data.frame(x31, x32, x33, data)

#----------------------------------------------------------------------
# Fit RIFRF
#----------------------------------------------------------------------
fit_rifrf1_c <- lmrob(Yc ~ x11 + x12 + x13 + Xc + Xr, data = data11, subset = train)
pred_rifrf1_c <- predict(fit_rifrf1_c, data11[-train, ])

fit_rifrf2_c <- lmrob(Yc ~ x21 + x22 + x23 + Xc + Xr, data = data12, subset = train)
pred_rifrf2_c <- predict(fit_rifrf2_c, data12[-train, ])

fit_rifrf3_c <- lmrob(Yc ~ x31 + x32 + x33 + Xc + Xr, data = data13, subset = train)
pred_rifrf3_c <- predict(fit_rifrf3_c, data13[-train, ])

fit_rifrf1_r <- lmrob(Yr ~ x11 + x12 + x13 + Xc + Xr, data = data11, subset = train)
pred_rifrf1_r <- predict(fit_rifrf1_r, data11[-train, ])

fit_rifrf2_r <- lmrob(Yr ~ x21 + x22 + x23 + Xc + Xr, data = data12, subset = train)
pred_rifrf2_r <- predict(fit_rifrf2_r, data12[-train, ])

fit_rifrf3_r <- lmrob(Yr ~ x31 + x32 + x33 + Xc + Xr, data = data13, subset = train)
pred_rifrf3_r <- predict(fit_rifrf3_r, data13[-train, ])

pred_rifrf_c <- (mem[-train,1]*pred_rifrf1_c + mem[-train,2]*pred_rifrf2_c + mem[-train,3]*pred_rifrf3_c) /
  (mem[-train,1] + mem[-train,2] + mem[-train,3])

pred_rifrf_r <- (mem[-train,1]*pred_rifrf1_r + mem[-train,2]*pred_rifrf2_r + mem[-train,3]*pred_rifrf3_r) /
  (mem[-train,1] + mem[-train,2] + mem[-train,3])

pred_rifrf_r <- pmax(pred_rifrf_r, 0)
pred_rifrf_l <- pred_rifrf_c - 0.5 * pred_rifrf_r
pred_rifrf_u <- pred_rifrf_c + 0.5 * pred_rifrf_r

